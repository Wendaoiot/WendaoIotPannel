# =====================================================================
# WendaoIotPannel Linux 裸机部署配置
# 用法： cp deploy.env.example deploy.env  按需修改；deploy.env 不入库。
# 留空/留默认时脚本会自动生成强随机值（落盘 /opt/wendao/secrets/，600）。
# =====================================================================

# ---- 通用 ----
INSTALL_DIR=/opt/wendao
APP_USER=wendao
APP_GROUP=wendao
DOMAIN=pannel.wendaoiot.com
CERT_DIR=/opt/wendao/certs

# ---- 服务端口 ----
SERVER_PORT=8080
MYSQL_PORT=3306
MQTT_PORT=1883
MQTT_TLS_PORT=8883

# ---- MySQL ----
MYSQL_DATABASE=wendaoiot
MYSQL_APP_USER=wendaoiot
# 留空则自动生成并记录到 secrets/mysql_app_password
MYSQL_APP_PASSWORD=
# root 密码自动生成到 secrets/mysql_root_password
MYSQL_ROOT_PASSWORD=

# ---- 后端配置 ----
# JWT / EMQX hook 共享密钥留空自动生成
JWT_SECRET=
MQTT_HOOK_SECRET=
# 后端自身连接 broker 的平台账号（走 EMQX 内置认证库）
MQTT_SERVER_USER=wendao_server
MQTT_SERVER_PASSWORD=

# ---- EMQX（裸机安装 5.x）----
EMQX_DASHBOARD_USER=admin
# Dashboard 初始密码留空自动生成
EMQX_DASHBOARD_PASSWORD=
EMQX_DASHBOARD_PORT=18083
EMQX_API_KEY_NAME=wendao-backend-kick

# ---- 前端构建（需要联网下载依赖；设为 skip 跳过）----
BUILD_FRONTEND=true

# ---- 做什么（菜单用；不直接改）----
# install-deps / database / certs / configure-emqx / backend / frontend / all
STEPS=all
