# WendaoIotPannel 容器栈环境变量
# 用法： cp .env.example .env  然后按需修改；:.gitignore 已忽略 .env（不入库）

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_mysql_root
MYSQL_DATABASE=wendaoiot
MYSQL_PORT=3306

# ---- EMQX ----
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=change_me_dashboard
EMQX_DASHBOARD_PORT=18083
EMQX_NODE_COOKIE=wqemqxcookie_local

# MQTT 端口
MQTT_PORT=1883
MQTT_TLS_PORT=8883
MQTT_WS_PORT=8083
MQTT_WSS_PORT=8084

# ---- 宿主机 Go 后端端口（EMQX 容器经 host.docker.internal 回调 auth/acl）----
SERVER_PORT=8080

# ---- 后端与 EMQX 对接的共享密钥（同时写入 server/config.yaml 的 mqtt_auth_secret）----
MQTT_HOOK_SECRET=change_me_hook_secret_at_least_16_chars

# ---- EMQX 内置认证库中的平台超管账号（后端自身连接 broker 用，区别于设备密钥）----
MQTT_SERVER_USER=wendao_server
MQTT_SERVER_PASSWORD=change_me_mqtt_server

# ---- EMQX REST API Key（后端互踢用；configure-emqx 脚本会自动创建并输出）----
EMQX_API_KEY_NAME=wendao-backend-kick
